# ---- Server ----
NODE_ENV=development
PORT=5000
# Exact browser origin(s) allowed to call the API (comma-separated). No wildcards.
CLIENT_URL=http://localhost:5173

# ---- MongoDB (local by default; Atlas: mongodb+srv://user:pass@cluster/wordvault) ----
MONGODB_URI=mongodb://127.0.0.1:27017/wordvault
# Used only by `npm test`. The database name MUST end in _test or tests refuse to run.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/wordvault_test

# ---- Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=
# Token/cookie lifetime in days
SESSION_DAYS=7
# bcrypt cost factor (10-14). 12 is a good default.
BCRYPT_ROUNDS=12
# Set true only when served over HTTPS (production)
COOKIE_SECURE=false

# ---- AI vocabulary generation (optional; app works without it) ----
# AI_PROVIDER: anthropic | openai   ("openai" = any OpenAI-compatible chat API: OpenAI, Gemini compat, Groq, Ollama...)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Only for AI_PROVIDER=openai (default https://api.openai.com/v1). Ollama example: http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_TIMEOUT_MS=60000

# ---- Translation provider (optional; falls back to the AI_* values when blank) ----
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_BASE_URL=
# Comma-separated language codes you have found the provider translates poorly (blocked in the UI)
TRANSLATION_UNSUPPORTED_LANGUAGES=

# ---- Rate limits ----
AI_GENERATIONS_PER_HOUR=20
