{
  "name": "wordvault-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "vitest run",
    "db:init": "node --env-file-if-exists=../.env scripts/initDb.js",
    "db:check": "node --env-file-if-exists=../.env scripts/checkDb.js",
    "db:seed": "node --env-file-if-exists=../.env scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
